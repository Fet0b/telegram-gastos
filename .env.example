# Token do bot, gerado pelo @BotFather no Telegram.
# NUNCA commitar o valor real — trate como senha.
TELEGRAM_BOT_TOKEN=

# IDs numéricos do Telegram autorizados a usar o bot, separados por vírgula.
# Descubra o seu ID falando com @userinfobot no Telegram.
# Qualquer mensagem de um ID fora desta lista é ignorada.
AUTHORIZED_USER_IDS=

# Fuso horário usado para registrar a hora dos gastos (nomes da IANA tz database).
TIMEZONE=America/Sao_Paulo

# Caminho, dentro do container, onde a planilha de gastos é salva/lida.
# Deve apontar para um volume montado, para persistir entre reinícios do container.
EXCEL_FILE_PATH=/data/gastos.xlsx

# Intervalo (segundos) entre chamadas de long polling ao Telegram.
POLLING_INTERVAL_SECONDS=30
